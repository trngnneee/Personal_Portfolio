# --- Server ---
NODE_ENV=development
PORT=4000
# Comma-separated allowlist of browser origins (public site + admin).
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# --- Database (PostgreSQL) ---
# Local: `npm run db:up` (Docker Compose) at the repo root.
# Production: Supabase → Connect → "Session pooler" URI (IPv4), e.g.
#   postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=postgres://portfolio:portfolio@localhost:5432/portfolio
DATABASE_SSL=false
# Optional PEM CA for full TLS verification (Supabase → Database settings → SSL certificate).
# Single line with \n escapes is accepted.
DATABASE_CA_CERT=
DATABASE_POOL_MAX=10

# --- Auth ---
# >= 32 bytes. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-bytes
# Salt for hashing contact-form IPs.
IP_HASH_SALT=change-me

# --- Cloudinary (optional in dev: seed with --no-upload) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=portfolio

# --- Email notifications for contact messages (optional) ---
RESEND_API_KEY=
RESEND_FROM=Portfolio <noreply@trngnneee.io.vn>

# --- Public URLs ---
PUBLIC_SITE_URL=http://localhost:5173
PUBLIC_API_URL=http://localhost:4000
UPLOADS_DIR=./data/uploads
