# Backend base URL (no trailing slash)
VITE_API_URL=http://localhost:4000
# Cloudinary cloud name, used to build responsive image URLs
VITE_CLOUDINARY_CLOUD_NAME=
# Canonical public URL of this site (OG tags, JSON-LD)
VITE_SITE_URL=http://localhost:5173
# AI chat widget: portfolio-bot base URL (no trailing slash). Empty → widget hidden.
VITE_ASSISTANT_URL=
# Cloudflare Turnstile site key. Empty → no challenge (bot without TURNSTILE_SECRET).
# Local testing against a bot with Turnstile: use Cloudflare's test key 1x00000000000000000000AA.
VITE_TURNSTILE_SITE_KEY=
